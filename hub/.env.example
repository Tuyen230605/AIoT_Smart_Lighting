# copy .env.example -> .env rồi điền. .env nằm trong .gitignore.
MQTT_HOST=broker
MQTT_PORT=1883
MQTT_USER=oi
MQTT_PASS=doi_mat_khau_nay

TZ=Asia/Ho_Chi_Minh
LATITUDE=21.0285          # dùng để tính giờ hoàng hôn — đặc trưng của AI-6
LONGITUDE=105.8542

ASR_MODEL=/models/phowhisper-small-ct2
ASR_COMPUTE_TYPE=int8
ASR_BEAM_SIZE=1

LLM_MODEL=/models/qwen2.5-1.5b-instruct-q4_k_m.gguf
LLM_CTX=2048
LLM_THREADS=4

VISION_DEVICE=/dev/video0
VISION_FPS=8

POLICY_DB=/data/oi.db
POLICY_RETRAIN_CRON=0 3 * * *
