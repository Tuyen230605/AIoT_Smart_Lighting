# copy .env.example -> .env rồi điền. .env nằm trong .gitignore.
# Các dịch vụ dùng tài khoản `svc` (toàn quyền trên oi/#).
# Dashboard trong trình duyệt dùng tài khoản `ui` riêng, quyền hẹp hơn —
# mật khẩu của nó ai mở trang cũng đọc được, xem hub/config/mosquitto/acl.
OI_MQTT_HOST=broker
OI_MQTT_PORT=1883
OI_MQTT_USER=svc
OI_MQTT_PASS=doi_mat_khau_nay
OI_LOG_LEVEL=INFO

TZ=Asia/Ho_Chi_Minh
LATITUDE=21.0285          # dùng để tính giờ hoàng hôn — đặc trưng của AI-6
LONGITUDE=105.8542

ASR_MODEL=/models/phowhisper-small-ct2
ASR_COMPUTE_TYPE=int8
ASR_BEAM_SIZE=1

LLM_MODEL=/models/qwen2.5-1.5b-instruct-q4_k_m.gguf
LLM_CTX=2048
LLM_THREADS=4

OI_DB_PATH=/data/oi.sqlite

# ── Thị giác ──────────────────────────────────────────────────
OI_CAM_WIDTH=640
OI_CAM_HEIGHT=480
OI_CAM_FPS=8
OI_YOLO_WEIGHTS=/models/yolov8n.pt   # thiếu file này thì tự lùi về bộ dò chuyển động
OI_YOLO_IMGSZ=320
OI_YOLO_CONF=0.4
OI_ZONES_PATH=/data/zones.json

# Luồng hình chú giải (ADR 0005) — chỉ mã hoá khi có người đang xem
OI_STREAM_PORT=8090
OI_STREAM_FPS=6
OI_STREAM_QUALITY=70

OI_POLICY_TICK_S=10
OI_CTX_TICK_S=1
POLICY_RETRAIN_CRON=0 3 * * *        # dùng từ G3.7, khi có mô hình học
