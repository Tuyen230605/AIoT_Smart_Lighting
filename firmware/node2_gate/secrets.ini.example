; ══════════════════════════════════════════════════════════════
;  MẪU cấu hình bí mật — Node 2
;
;  CÁCH DÙNG
;    1. copy secrets.ini.example  ->  secrets.ini
;    2. điền giá trị thật vào secrets.ini
;    3. secrets.ini đã nằm trong .gitignore — KHÔNG BAO GIỜ commit nó
;
;  Chứng chỉ AWS KHÔNG nằm ở đây. Chúng được nạp vào phân vùng NVS bằng
;      python tools/provision/provision_node.py --port COM5 --node node2
;  để không bao giờ có mặt trong mã nguồn lẫn trong ảnh firmware.
; ══════════════════════════════════════════════════════════════
[secrets]
build_flags =
    -D WIFI_SSID='"TEN_WIFI_CUA_BAN"'
    -D WIFI_PASS='"MAT_KHAU_WIFI"'
    -D HUB_MQTT_HOST='"192.168.1.10"'
    -D HUB_MQTT_PORT=1883
    -D AWS_MQTT_HOST='"xxxxxxxx-ats.iot.ap-southeast-2.amazonaws.com"'
